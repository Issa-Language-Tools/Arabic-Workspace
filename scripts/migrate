#!/bin/bash

DATETIME=$(date -u +%Y%m%dT%H%M%S)
MIGRATION_DIR="migrations/"
DELIM="_"

FILENAME=""

if [[ $# -gt 0 ]]; then
  FILENAME="$1"
else
  echo "Error: you must specify a filename. Usage: scripts/migrate [FILENAME]"
  exit 1
fi

#/usr/bin/touch $MIGRATION_DIR$DATETIME$DELIM$FILENAME.sql
echo "created: $MIGRATION_DIR$DATETIME$DELIM$FILENAME.sql"
# OUTPUT looks like: YYYYMMDDTHHMMSS_<FILENAME>.sql
